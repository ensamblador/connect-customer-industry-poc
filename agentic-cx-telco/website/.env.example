# Configuracion del Widget de Amazon Connect para el sitio "Latam Telco".
# Copia este archivo a `.env` (desarrollo) o `.env.production` (produccion) y
# completa los valores. Solo las variables con prefijo VITE_ se incrustan en el
# bundle durante `vite build` (no se leen en runtime).

# === Requeridas (su ausencia rompe el build y detiene la sintesis de CDK) ===
VITE_CONNECT_SNIPPET_ID=
VITE_CONNECT_WIDGET_ID=
VITE_CONNECT_SCRIPT_URL=
VITE_CONNECT_INSTANCE_ALIAS=

# === Opcionales (tienen valor por defecto si se omiten) ===
# Color primario (morado) del widget. Default: #1a0052
VITE_WIDGET_PRIMARY_COLOR=#1a0052
# Color de acento (rosa-rojo) del widget. Default: #e60050
VITE_WIDGET_ACCENT_COLOR=#e60050
# Email por defecto en contactAttributes cuando no hay sesion. Default: example@example.com
VITE_DEFAULT_CONTACT_EMAIL=example@example.com
