# ---------------------------------------------------------------------------
# Connect Customer Industry PoC — environment template
#
# Copy to `.env` at the repo root and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
#
# Every app's config.py reads these as REQUIRED environment variables and
# raises if any is missing, so source this file once per shell before running
# `cdk` or the post-deploy scripts. Lines below carry `export`, so a plain
# source is enough from inside an app directory:
#
#     source ../.env
#
# (`set -a; source ../.env; set +a` also works and does not need the `export`
# prefixes. Or use direnv to load it automatically on `cd`.)
#
# All four apps — general-localization plus the three industry apps — point at
# the SAME Connect instance and Q in Connect assistant, so this one root file
# configures the whole repo.
# ---------------------------------------------------------------------------

# Amazon Connect instance alias — the subdomain of your instance access URL
# (https://<alias>.my.connect.aws). Also builds the OIDC discovery URL used by
# the AgentCore MCP gateway's inbound JWT authorizer.
export INSTANCE_ALIAS=replace-with-connect-instance-alias

# Amazon Connect instance id (UUID) — the id at the end of the instance ARN.
# CLI: aws connect list-instances
export INSTANCE_ID=00000000-0000-0000-0000-000000000000

# Q in Connect assistant id (UUID), a.k.a. the "AI agents domain" id.
# CLI: aws qconnect list-assistants
export ASSISTANT_ID=00000000-0000-0000-0000-000000000000
